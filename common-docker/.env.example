# Shared services. Copy to .env and replace credentials before first launch.
# Existing installations MUST retain their established Postgres/MinIO credentials.
COMMON_POSTGRES_USER=forensic
COMMON_POSTGRES_PASSWORD=forensic
COMMON_POSTGRES_DB=forensic
COMMON_POSTGRES_PORT=5434
COMMON_MINIO_ROOT_USER=minioadmin
COMMON_MINIO_ROOT_PASSWORD=minioadmin
COMMON_MINIO_DATA_DIR=../backup/minio
COMMON_MINIO_PORT=9004
COMMON_MINIO_CONSOLE_PORT=9005
COMMON_OPENSEARCH_PORT=19200
REDIS_HOST_PORT=6380
PGADMIN_DEFAULT_EMAIL=admin@forensic.example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5052
COMMON_SMTP_PORT=1025
COMMON_MAILHOG_UI_PORT=8025

# Image published by Chainguard on Docker Hub (avoids cgr.dev/R2 proxy issues).
COMMON_MINIO_IMAGE=chainguard/minio:latest
